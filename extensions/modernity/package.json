{
  "name": "modernity",
  "displayName": "Modernity",
  "description": "Built-in Modernity language model provider for Minecraft modding IDE",
  "publisher": "modernity",
  "version": "0.0.1",
  "isModernityCore": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguageModelChat:modernity"
  ],
  "enabledApiProposals": [
    "chatProvider",
    "languageModelSystem",
    "languageModelCapabilities"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "modernity",
        "displayName": "Modernity"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "modernity-sandbox",
        "label": "Modernity Sandbox Tools"
      }
    ],
    "configuration": [
      {
        "title": "Modernity",
        "properties": {
          "modernity.gatewayUrl": {
            "type": "string",
            "description": "Base URL for the Modernity inference gateway when MODERNITY_API_BASE_URL is not set.",
            "default": "http://127.0.0.1:8000",
            "scope": "application"
          },
          "modernity.chatCompletionsUrl": {
            "type": "string",
            "description": "Full URL override for chat completions endpoint. If set, takes precedence over gatewayUrl.",
            "default": "",
            "scope": "application"
          },
          "modernity.modelsUrl": {
            "type": "string",
            "description": "Full URL override for models endpoint. If set, takes precedence over gatewayUrl.",
            "default": "",
            "scope": "application"
          }
        }
      }
    ],
    "configurationDefaults": {
      "chat.detectParticipant.enabled": true
    }
  },
  "main": "./out/extension",
  "browser": "./dist/browser/extension",
  "scripts": {
    "compile": "gulp compile-extension:modernity",
    "watch": "gulp watch-extension:modernity",
    "vscode:prepublish": "npm run compile"
  }
}
