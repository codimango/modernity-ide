{
  "name": "modernity",
  "displayName": "Modernity",
  "description": "Built-in Modernity language model provider for Minecraft modding IDE",
  "publisher": "modernity",
  "version": "0.0.1",
  "isModernityCore": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguageModelChat:modernity",
    "onChatParticipant:modernity.episodes",
    "onCommand:modernity.beginSweSession",
    "onCommand:modernity.sweSession",
    "onCommand:modernity.acceptFeature",
    "onCommand:modernity.submitFeature",
    "onCommand:modernity.gradeFeature",
    "onCommand:modernity.syncAcceptedFeature",
    "onCommand:modernity.toggleCollectData",
    "onCommand:modernity.createProject",
    "onCommand:modernity.addHint"
  ],
  "enabledApiProposals": [
    "chatProvider",
    "chatParticipantAdditions",
    "chatParticipantPrivate",
    "languageModelSystem",
    "languageModelCapabilities"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "modernity",
        "displayName": "Modernity"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "modernity-sandbox",
        "label": "Modernity Sandbox Tools"
      }
    ],
    "chatParticipants": [
      {
        "id": "modernity.episodes",
        "name": "modernity",
        "fullName": "%episodes.participant.name%",
        "description": "%episodes.participant.description%",
        "commands": [
          {
            "name": "start-project",
            "description": "%episodes.cmd.startProject%"
          },
          {
            "name": "hint",
            "description": "%episodes.cmd.hint%"
          }
        ],
        "modes": [
          "agent"
        ]
      }
    ],
    "commands": [
      {
        "command": "modernity.sweSession",
        "title": "%episodes.sweSession%",
        "icon": "$(beaker)"
      },
      {
        "command": "modernity.enableBenchmarkEpisodes",
        "title": "%episodes.enable%"
      },
      {
        "command": "modernity.toggleCollectData",
        "title": "%episodes.toggle%",
        "icon": "$(record)"
      },
      {
        "command": "modernity.createProject",
        "title": "%episodes.createProject%",
        "icon": "$(new-folder)"
      },
      {
        "command": "modernity.restartSandboxDaemon",
        "title": "%episodes.restartDaemon%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "modernity.addHint",
        "title": "%episodes.hint%",
        "icon": "$(lightbulb)"
      },
      {
        "command": "modernity.acceptFeature",
        "title": "%episodes.submit%",
        "icon": "$(check-all)"
      },
      {
        "command": "modernity.submitFeature",
        "title": "%episodes.submitTask%",
        "icon": "$(package)"
      },
      {
        "command": "modernity.gradeFeature",
        "title": "%episodes.gradeTask%",
        "icon": "$(pass-filled)"
      },
      {
        "command": "modernity.syncAcceptedFeature",
        "title": "%episodes.sync%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "modernity.continueFeature",
        "title": "%episodes.continue%",
        "icon": "$(sparkle)"
      },
      {
        "command": "modernity.openProjectViewer",
        "title": "%episodes.openProject%",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "modernity.openEpisodeTrace",
        "title": "%episodes.openTrace%",
        "icon": "$(pulse)"
      },
      {
        "command": "modernity.setBackendAccessToken",
        "title": "%episodes.setToken%"
      }
    ],
    "menus": {
      "chat/input/status": [
        {
          "command": "modernity.gradeFeature",
          "when": "config.modernity.benchmarkEpisodes.enabled && modernity.episode.active && modernity.episode.session && !modernity.episode.submittable",
          "group": "navigation@1"
        },
        {
          "command": "modernity.submitFeature",
          "when": "config.modernity.benchmarkEpisodes.enabled && modernity.episode.submittable && modernity.episode.session",
          "group": "navigation@1"
        },
        {
          "command": "modernity.addHint",
          "when": "config.modernity.benchmarkEpisodes.enabled && modernity.episode.active && modernity.episode.session",
          "group": "navigation@2"
        },
        {
          "command": "modernity.toggleCollectData",
          "when": "modernity.project.active || config.modernity.benchmarkEpisodes.enabled",
          "group": "navigation@5"
        },
        {
          "command": "modernity.openProjectViewer",
          "when": "config.modernity.benchmarkEpisodes.enabled && modernity.project.active",
          "group": "navigation@4"
        },
        {
          "command": "modernity.syncAcceptedFeature",
          "when": "config.modernity.benchmarkEpisodes.enabled && modernity.episode.syncPending",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": [
      {
        "title": "Modernity",
        "properties": {
          "modernity.benchmarkEpisodes.enabled": {
            "type": "boolean",
            "markdownDescription": "%episodes.config.enabled%",
            "default": false,
            "scope": "application"
          },
          "modernity.benchmarkEpisodes.exportBundle": {
            "type": "boolean",
            "markdownDescription": "%episodes.config.exportBundle%",
            "default": true,
            "scope": "application"
          },
          "modernity.benchmarkEpisodes.publishRepositoryPath": {
            "type": "string",
            "markdownDescription": "%episodes.config.publishRepositoryPath%",
            "default": "",
            "scope": "application"
          },
          "modernity.benchmarkEpisodes.publishBranch": {
            "type": "string",
            "markdownDescription": "%episodes.config.publishBranch%",
            "default": "main",
            "scope": "application"
          },
          "modernity.webUrl": {
            "type": "string",
            "description": "%episodes.config.webUrl%",
            "default": "",
            "scope": "application"
          },
          "modernity.gatewayUrl": {
            "type": "string",
            "description": "%episodes.config.gatewayUrl%",
            "default": "http://127.0.0.1:8000",
            "scope": "application"
          },
          "modernity.chatCompletionsUrl": {
            "type": "string",
            "description": "%episodes.config.chatCompletionsUrl%",
            "default": "",
            "scope": "application"
          },
          "modernity.modelsUrl": {
            "type": "string",
            "description": "%episodes.config.modelsUrl%",
            "default": "",
            "scope": "application"
          }
        }
      }
    ],
    "configurationDefaults": {
      "chat.detectParticipant.enabled": true
    }
  },
  "main": "./out/extension",
  "browser": "./dist/browser/extension",
  "scripts": {
    "compile": "gulp compile-extension:modernity",
    "watch": "gulp watch-extension:modernity",
    "vscode:prepublish": "npm run compile"
  }
}
